{
  "name": "openshop",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "start": "pnpm --filter @openshop/web build && pnpm --filter @openshop/server start",
    "dev": "pnpm --parallel --filter @openshop/server --filter @openshop/web dev",
