# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# Which compose files make up the stack (docker compose reads this from .env too).
# Shared server behind the edge Caddy (/opt/edge, from the hive repo's deploy/edge):
COMPOSE_FILE=docker-compose.yml:docker-compose.edge.yml
# OpenShop alone on the machine, with its own Caddy on 80/443:
# COMPOSE_FILE=docker-compose.yml:docker-compose.caddy.yml
# Add :docker-compose.build.yml to either to build the image here from a checkout instead of pulling.

# The domain, with its DNS A record pointing at this server. The only setting to change when the
# domain changes. Without a domain yet: shop.<ip with dashes>.sslip.io resolves to the IP.
OPENSHOP_DOMAIN=openshop.example
# How customers reach the site (payment return links, MCP, llms.txt). Defaults to https://$OPENSHOP_DOMAIN.
# PUBLIC_URL=https://openshop.example
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# Signs merchants' preview links; unset, they stop working on every restart. openssl rand -hex 32
PREVIEW_SECRET=

# How often unpaid orders are checked with the payment provider, in ms.
PAYMENT_SYNC_MS=10000
# Alipay 电脑网站支付. Leave ALIPAY_APP_ID empty to use the fake cashier.
# Keys are the raw base64 strings without PEM header lines; the private key is PKCS#1.
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# Empty means the sandbox. Production: https://openapi.alipay.com/gateway.do
ALIPAY_GATEWAY=

# 1 creates the two demo shops on first start; 0 for a clean database.
SEED=1
# 1 also creates the workbench demo accounts (moon-nail, baiyi, xiangkou; password openshop123,
# published in the code). Off in production unless set.
SEED_ACCOUNTS=

# Daily backups into ./backups.
BACKUP_KEEP_DAYS=14
# 19 UTC = 03:00 Beijing.
BACKUP_HOUR_UTC=19
