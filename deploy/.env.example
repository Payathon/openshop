# Copy to deploy/.env and fill in. Never commit .env.

# The domain you bought, with its DNS A record pointing at this server.
OPENSHOP_DOMAIN=openshop.example
# How customers reach the site; used in payment return links, MCP and llms.txt.
PUBLIC_URL=https://openshop.example
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# How often unpaid orders are checked with the payment provider, in ms.
PAYMENT_SYNC_MS=10000
# 1 creates the two demo shops on first start; 0 for a clean database.
SEED=1

# Daily backups into deploy/backups.
BACKUP_KEEP_DAYS=14
# 19 UTC = 03:00 Beijing.
BACKUP_HOUR_UTC=19
